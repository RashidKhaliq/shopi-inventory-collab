// prisma/schema.prisma - Multi-Store Shopify Inventory Sync Schema
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Store {
  id            String   @id @default(cuid())
  shopDomain    String   @unique
  name          String
  accessToken   String
  ownerEmail    String
  supplierName  String   // e.g. "Rashid" or "Hamza" matching Supplier: Name tag
  webhookSecret String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shopDomain])
  @@index([supplierName])
}

model ProcessedWebhook {
  id          String   @id @default(cuid())
  webhookId   String   @unique
  topic       String
  shopDomain  String
  processedAt DateTime @default(now())

  @@index([webhookId])
}

model OrderSync {
  id               String   @id @default(cuid())
  sourceShopDomain String
  targetShopDomain String
  sourceOrderId    String
  sourceOrderName  String
  targetOrderId    String?
  targetOrderName  String?
  status           String   // SUCCESS | FAILED | SKIPPED
  skus             String
  error            String?
  createdAt        DateTime @default(now())

  @@index([sourceShopDomain])
  @@index([targetShopDomain])
}

model InventorySync {
  id               String   @id @default(cuid())
  sku              String
  sourceShopDomain String
  targetShopDomain String
  previousQty      Int
  newQty           Int
  status           String   // SUCCESS | FAILED
  syncedAt         DateTime @default(now())

  @@index([sku])
}

model SyncLog {
  id         String   @id @default(cuid())
  level      String   // INFO | WARN | ERROR
  topic      String?
  shopDomain String?
  message    String
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
